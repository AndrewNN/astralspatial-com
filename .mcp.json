{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.86",
        "--browser",
        "chromium",
        "--headless",
        "--isolated",
        "--viewport-size",
        "1440,900",
        "--output-dir",
        "docs/screenshots"
      ]
    }
  }
}
